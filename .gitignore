# Dependencias
node_modules/

# Builds
.next/
out/
dist/
build/

# Entorno
.env
.env.local
.env.*.local

# Prisma
prisma/*.db

# Logs y SO
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Temporales de generación de documentos
.build-docx/
.verify/

# Estado local de herramientas de agente (no compartir entre máquinas)
.claude/scheduled_tasks.lock
graphify-out/

# Subidas de usuarios — fotos de propiedades y de perfil.
# Van a disco local (ver api/upload/route.ts); son datos de clientes, no
# código, y no deben entrar al control de versiones. Se conservan los
# .gitkeep para que la estructura de carpetas exista tras un clone.
apps/web/public/uploads/**
!apps/web/public/uploads/**/.gitkeep

# Documentos privados subidos por usuarios (cédulas, contratos, comprobantes).
# Ver src/lib/uploads.ts: viven fuera de public/ y jamás se versionan.
apps/web/private-uploads/

# Worktrees aislados de agentes (copias completas del repo)
.claude/worktrees/
