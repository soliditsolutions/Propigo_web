// Housing — esquema de datos del MVP.
// Traducción de docs/04-esquema-bd.md. RLS, triggers (ledger inmutable),
// índice único parcial y vistas de saldos se aplican por SQL aparte
// (prisma/sql/setup.sql), porque Prisma no los modela en el schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

// manager: dueño de la cuenta (uno por Tenant, fijo esta fase) — ve/gestiona todo.
// colaborador: staff invitado por el manager — solo ve/gestiona propiedades asignadas.
// Renombrado desde admin/operador (ADR-0013, cuentas multi-usuario) — ver migración
// rename_rol_usuario_values (ALTER TYPE ... RENAME VALUE, sin backfill de filas).
enum RolUsuario {
  manager
  colaborador
}

enum TipoPropiedad {
  casa
  departamento
  cabana
}

enum EstadoPropiedad {
  borrador      // Recién creada, pendiente de confirmación por el corredor
  disponible
  reservada
  arrendada
}

enum Denominacion {
  UF
  CLP
}

enum FrecuenciaReajuste {
  anual
  semestral
  ninguna
}

enum EstadoContrato {
  borrador
  vigente
  terminado
  terminado_anticipado
  cancelado            // Borrador anulado antes de activarse — nunca estuvo vigente
}

/**
 * Por qué terminó un contrato.
 *
 * Las causales salen de la Ley 18.101 y del Código Civil. `otra` existe porque
 * el corredor no puede quedar bloqueado por un caso que la lista no previó.
 */
enum CausalTermino {
  /// Las partes acuerdan poner término. Es el caso normal y el más limpio.
  mutuo_acuerdo
  /// Llegó la fecha de fin pactada y nadie renovó.
  vencimiento_plazo
  /// El arrendador pone término con aviso (Ley 18.101 arts. 3 y 4).
  desahucio_arrendador
  /// El arrendatario avisa que se va antes del vencimiento.
  desahucio_arrendatario
  /// Mora en el pago de la renta (Código Civil art. 1977).
  no_pago_renta
  /// Incumplimiento de otra obligación del contrato.
  incumplimiento_contrato
  /// El inmueble se destruyó o quedó inhabitable.
  destruccion_inmueble
  /// Se extinguió el derecho del arrendador sobre el inmueble (venta, remate).
  expiracion_derecho_arrendador
  otra
}

enum EstadoPeriodo {
  pendiente
  pagado
  liquidado
  atrasado
  en_revision
  cancelado     // Período futuro anulado al terminar o cancelar el contrato
}

enum EstadoPublicacion {
  borrador
  publicada
  bajada
}

enum EstadoReserva {
  activa
  cancelada
  convertida
}

enum EstadoPago {
  en_revision
  conciliado
  anulado
}

enum CanalPago {
  PAC
  pago_facil
  transferencia_declarada
  otro
}

enum TipoConcepto {
  arriendo
  gasto_comun
  interes
  multa
  ajuste
  garantia
}

enum TipoAjuste {
  descuento_propietario
  cargo_arrendatario
  retencion
}

enum TipoVoucher {
  pago
  liquidacion
}

/**
 * Contador de folios de documentos, uno por (corredora, tipo, año).
 *
 * Existe como tabla y no como un max()+1 sobre voucher porque el folio es un
 * correlativo legal: no puede saltarse ni repetirse aunque dos emisiones ocurran
 * a la vez. El upsert con increment sobre la fila única serializa a los
 * concurrentes; el índice único (setup.sql) lo respalda.
 */
model FolioCounter {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  tipo     TipoVoucher
  anio     Int         @db.SmallInt
  /// Último número entregado. El siguiente folio es este + 1.
  ultimo   Int         @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tipo, anio])
  @@map("folio_counter")
}

enum TipoAsiento {
  CARGO_ARRIENDO
  CARGO_GASTO_COMUN
  CARGO_INTERES
  CARGO_MULTA
  CARGO_AJUSTE
  PAGO_RECIBIDO
  COMISION_CORREDOR
  // IVA de la comisión (corredora persona jurídica). Lo soporta el propietario:
  // se descuenta de su liquidación junto con la comisión (decisión 2026-09, L-IV).
  IVA_COMISION
  AJUSTE_LIQUIDACION
  LIQUIDACION_PROPIETARIO
  GARANTIA_RECIBIDA
  RETENCION_GARANTIA
  DEVOLUCION_GARANTIA
  // Reajuste UF de la garantía al cierre. Cuando la garantía se pactó en UF,
  // el monto a restituir se revaloriza a la UF del día de término (práctica
  // legal chilena). La diferencia contra lo recibido (que quedó registrado en
  // GARANTIA_RECIBIDA a la UF del día de recepción) es este asiento — positivo
  // si la UF subió (lo aporta el propietario), negativo si bajó. Sin él, la
  // vista v_garantia_retenida no cerraría a cero al liquidar una garantía UF.
  REAJUSTE_GARANTIA
}

enum TipoNotificacion {
  cobro
  voucher_pago
  recordatorio_vencimiento
  liquidacion_propietario
  salida_anticipada
  termino_contrato
  nuevo_contrato
  solicitud_firma
  renovacion_contrato    // Notificación al arrendatario cuando se renueva el contrato
  comentario_corredor    // Corredor deja un comentario/mensaje en el portal del arrendatario
  alerta_personalizada   // Alerta definida por el admin de la corredora (AlertaPersonalizada)
}

enum CanalNotificacion {
  email
}

/** A quién va dirigida una alerta personalizada. Se resuelve a la Persona
 *  concreta usando el contrato sobre el que se envía. */
enum DestinatarioAlerta {
  arrendatario
  propietario
}

/** Cuándo se dispara sola una alerta. null en el modelo = solo envío manual.
 *  Ambos disparadores se anclan a un período de pago, que es lo único con
 *  fecha cierta contra la cual medir. */
/**
 * Hasta dónde llega una baja de notificaciones.
 *
 * Separar los dos alcances evita el peor escenario: que alguien pida "menos
 * correos" y con eso deje de enterarse de que su arriendo venció. Los avisos
 * esenciales son los que cambian obligaciones o dan cuenta de dinero —
 * vencimientos, atrasos, término de contrato, comprobantes, liquidaciones—;
 * los opcionales son comunicación de la corredora que no altera nada de eso.
 */
/**
 * Servicios básicos cuya cuenta se registra por propiedad.
 *
 * Es el set canónico: al dar de alta una propiedad, TODOS deben quedar
 * declarados — con sus datos o marcados "no aplica" (decisión G-05). Un
 * campo en blanco no es una respuesta: no distingue "no lo sé todavía" de
 * "esta casa no tiene gas de red".
 */
enum TipoServicioBasico {
  agua
  luz
  gas
  gastos_comunes
  otro
}

/** Si la cuenta existe y se registró, o si el servicio no aplica al inmueble. */
enum EstadoCuentaServicio {
  registrada
  no_aplica
}

/** Quién paga la cuenta. Es lo que se discute al cerrar un contrato. */
enum PagadorServicio {
  arrendatario
  propietario
}

/** Tipo de cuenta bancaria, tal como lo pide cualquier formulario chileno. */
enum TipoCuentaBancaria {
  corriente
  vista
  ahorro
  cuenta_rut
}

/**
 * Tipo de unidad accesoria con rol propio.
 *
 * En edificios y condominios cada unidad tiene su propio Rol de Avalúo: el
 * departamento uno, el estacionamiento otro, la bodega otro (hallazgo del
 * levantamiento de G-01). El rol habitacional vive en Propiedad.rol; estos
 * son los complementos, y son opcionales.
 */
enum TipoRolComplementario {
  estacionamiento
  bodega
  otro
}

enum AlcanceBaja {
  /// Deja de recibir solo los avisos informativos. Es el alcance recomendado.
  solo_opcionales
  /// Deja de recibir absolutamente todo, incluidos los avisos del contrato.
  todos
}

enum DisparadorAlerta {
  antes_de_vencimiento   // diasOffset días ANTES de la fecha de vencimiento
  dias_de_mora           // diasOffset días DESPUÉS, con el período ya atrasado
}

enum EstadoNotificacion {
  pendiente
  simulada
  enviada
  // Aviso de ciclo de vida que quedó obsoleto porque salió uno más nuevo del
  // mismo contrato (ver notificaciones-ciclo.ts). Nunca se envió; no es un fallo.
  reemplazada
}

enum TipoDocumento {
  contrato
  anexo
  comprobante_pago
  certificado_reserva
  reconocimiento_deuda
  otro
}

enum CanalOtp {
  email
  sms
}

// ───────────────────────── Modelos ─────────────────────────

model Tenant {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                  String
  /// RUT de la corredora, canónico sin puntos ("76123456-0"). Obligatorio y
  /// único: identifica la cuenta ante el SII y es lo que va en todo documento
  /// que la corredora emite. No es la PK —una PK no debería cambiar nunca y un
  /// RUT sí se corrige tras un typo— pero cumple el mismo rol identificador.
  rut                     String   @unique
  /// Decide si la comisión de la corredora lleva IVA. Una persona jurídica
  /// presta un servicio afecto; una persona natural que emite boleta de
  /// honorarios queda exenta por el DL 825 art. 12 letra E N° 8.
  esPersonaJuridica       Boolean  @default(true) @map("es_persona_juridica")
  /// Giro y domicilio comercial: menciones obligatorias del emisor en todo
  /// documento de cobro que emite la corredora.
  giro                    String?
  direccion               String?
  plan                    String?
  emailContacto           String?  @map("email_contacto")   // email público para recibir consultas del marketplace
  // Config operativa (ADR-0008)
  ventanaLiquidacionDias  Int      @default(10) @map("ventana_liquidacion_dias") @db.SmallInt
  recordatorioDiasAntes   Int      @default(5)  @map("recordatorio_dias_antes")  @db.SmallInt
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usuarios         Usuario[]
  personas         Persona[]
  propiedades      Propiedad[]
  imagenes         ImagenPropiedad[]
  publicaciones    Publicacion[]
  reservas         Reserva[]
  contratos        Contrato[]
  periodos         PeriodoPago[]
  ajustes          AjusteLiquidacion[]
  pagos            PagoEntrante[]
  asientos         AsientoLedger[]
  vouchers         Voucher[]
  notificaciones   Notificacion[]
  alertas          AlertaPersonalizada[]
  preferenciasNotif PreferenciaNotificacion[]
  cuentasServicio   CuentaServicio[]
  rolesComplementarios RolComplementario[]
  documentos       Documento[]
  accesosOtp       AccesoOtp[]
  accesosLog       AccesoLog[]
  consultasContacto ConsultaContacto[]
  valoraciones     ValoracionCorredor[]
  comentarios      ComentarioCorredor[]
  auditoriasEquipo AuditoriaEquipo[]
  consentimientosIa ConsentimientoIa[]
  consumosIa       ConsumoIaDiario[]
  // Billing (ADR-0014) — contabilidad Housing↔corredor, separada del ledger del arriendo
  suscripciones    SuscripcionTenant[]
  cargosBilling    CargoBilling[]
  comisiones       ComisionPlataforma[]
  cuentasBancarias CuentaBancaria[]
  foliosCounters   FolioCounter[]

  @@map("tenant")
}

// Solo corredores (staff de la corredora): rol manager (dueño, uno por
// Tenant) o colaborador (staff invitado, ve solo propiedades asignadas —
// ver Propiedad.asignadoAId). ADR-0013.
model Usuario {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  rol             RolUsuario @default(colaborador)
  nombre          String
  email           String
  rut             String?    // RUT chileno canónico sin puntos: "12345678-9" — unique global
  telefono        String?
  // Perfil del corredor — obligatorio para usar el panel
  fechaNacimiento DateTime?  @map("fecha_nacimiento")   @db.Date
  direccion       String?
  ciudad          String?
  region          String?
  fotoPerfil      String?    @map("foto_perfil")
  perfilCompleto  Boolean    @default(false) @map("perfil_completo")
  passwordHash    String?    @map("password_hash")      // PBKDF2-SHA256 (nullable = cuenta sin contraseña)
  failedAttempts  Int        @default(0) @map("failed_attempts")
  lockedUntil     DateTime?  @map("locked_until")       @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at")      @db.Timestamptz(6)
  // null = activo. No-nulo = colaborador desactivado por su manager (ADR-0013)
  // — pierde acceso en su próxima request (getActor() lo verifica), sus
  // propiedades asignadas vuelven a quedar sin asignar en la misma transacción
  // de desactivación. Nunca se fija en un Usuario con rol=manager.
  desactivadoEn   DateTime?  @map("desactivado_en")     @db.Timestamptz(6)
  // Ley 21.719 — consentimiento explícito e inequívoco (Art. 4)
  consentGivenAt  DateTime?  @map("consent_given_at")   @db.Timestamptz(6)
  consentVersion  String?    @map("consent_version")    // ej. "tys-v1.0"
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  pagosDeclarados  PagoEntrante[]      @relation("PagoDeclaradoPor")
  pagosConfirmados PagoEntrante[]      @relation("PagoConfirmadoPor")
  ajustesCreados   AjusteLiquidacion[] @relation("AjusteCreadoPor")
  resetTokens              ResetToken[]
  dispositivosConfiables   DispositivoConfiable[]
  codigosDispositivo       CodigoDispositivo[]
  codigosCambioContacto    CodigoCambioContacto[]
  propiedadesAsignadas     Propiedad[]             @relation("PropiedadAsignada")
  invitacionesCreadas      InvitacionColaborador[] @relation("InvitacionCreadaPor")
  auditoriasComoActor      AuditoriaEquipo[]       @relation("AuditoriaActor")
  auditoriasComoObjetivo   AuditoriaEquipo[]       @relation("AuditoriaObjetivo")
  consentimientosIa        ConsentimientoIa[]
  alertasCreadas AlertaPersonalizada[]

  @@index([tenantId])
  @@unique([rut])
  @@map("usuario")
}

// Propietarios y arrendatarios (sin cuenta). Acceden por portal OTP.
model Persona {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  rut             String
  nombre          String
  email           String?
  telefono        String?
  canalAccesoPref CanalOtp? @map("canal_acceso_pref")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                Tenant          @relation(fields: [tenantId], references: [id])
  propiedades           Propiedad[]
  contratosArrendatario Contrato[]      @relation("ContratoArrendatario")
  contratosPropietario  Contrato[]      @relation("ContratoPropietario")
  asientosArrendatario  AsientoLedger[] @relation("AsientoArrendatario")
  asientosPropietario   AsientoLedger[] @relation("AsientoPropietario")
  vouchers              Voucher[]
  reservas              Reserva[]
  notificaciones        Notificacion[]
  accesosOtp            AccesoOtp[]
  accesosLog            AccesoLog[]
  preferenciaNotif PreferenciaNotificacion[]
  cuentasBancarias CuentaBancaria[]

  @@index([tenantId])
  @@unique([tenantId, rut])
  @@map("persona")
}

model Propiedad {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  propietarioId      String          @map("propietario_id") @db.Uuid
  tipo               TipoPropiedad
  estado             EstadoPropiedad @default(borrador)
  /// Rol de Avalúo del SII de la unidad habitacional (G-01). Formato
  /// manzana-predio, con la comuna opcional: "573-24" o "13101-573-24".
  /// Obligatorio: identifica el inmueble ante el SII y va en el contrato.
  rol                String
  /// Si las partes del contrato pueden ver el rol en el portal. El corredor lo
  /// ve siempre y el contrato lo lleva igual: esto decide qué se comparte.
  rolVisibleEnPortal Boolean         @default(true) @map("rol_visible_en_portal")
  /// Avalúo fiscal del SII, en pesos. El Art. 10 de la Ley 18.101 lo exige
  /// como mención del contrato, y el DL 825 art. 17 lo usa como base de la
  /// deducción del 11 % que rebaja el IVA del arriendo amoblado. Lo ingresa el
  /// corredor a mano (decisión L-03): no hay servicio del SII que lo entregue.
  avaluoFiscal       Decimal?        @map("avaluo_fiscal") @db.Decimal(14, 0)
  direccion          String
  comuna             String?
  region             String?
  orientacion        String?
  antiguedadAnios    Int?            @map("antiguedad_anios")
  m2Construidos      Decimal?        @map("m2_construidos") @db.Decimal(8, 2)
  m2Totales          Decimal?        @map("m2_totales") @db.Decimal(8, 2)
  esCondominio       Boolean         @default(false) @map("es_condominio")
  plantas            Int?            @db.SmallInt
  piezas             Int?            @db.SmallInt
  banos              Int?            @db.SmallInt
  estacionamientos   Int?            @db.SmallInt
  pagaGastosComunes  Boolean         @default(false) @map("paga_gastos_comunes")
  valorGastosComunes Decimal?        @map("valor_gastos_comunes") @db.Decimal(14, 0)
  aceptaMascotas     Boolean         @default(false) @map("acepta_mascotas")
  otrasDescripciones String?         @map("otras_descripciones")
  latitud            Decimal?        @db.Decimal(9, 6)
  longitud           Decimal?        @db.Decimal(9, 6)
  mostrarUbicacionExacta Boolean     @default(false) @map("mostrar_ubicacion_exacta")
  // Colaborador a cargo (ADR-0013). null = sin asignar — invisible para todo
  // colaborador, siempre visible/gestionable para el manager sin importar
  // este campo. Exclusiva: como mucho un colaborador por propiedad.
  asignadoAId        String?         @map("asignado_a_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  propietario   Persona           @relation(fields: [propietarioId], references: [id])
  asignadoA     Usuario?          @relation("PropiedadAsignada", fields: [asignadoAId], references: [id])
  imagenes      ImagenPropiedad[]
  publicaciones Publicacion[]
  reservas      Reserva[]
  contratos     Contrato[]
  cuentasServicio      CuentaServicio[]
  rolesComplementarios RolComplementario[]
  documentos    Documento[]
  accesosOtp    AccesoOtp[]
  auditorias    AuditoriaEquipo[]

  @@index([tenantId])
  @@index([asignadoAId])
  @@map("propiedad")
}

model ImagenPropiedad {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  propiedadId String   @map("propiedad_id") @db.Uuid
  url         String
  orden       Int      @default(0) @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@map("imagen_propiedad")
}

model Publicacion {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  propiedadId        String            @map("propiedad_id") @db.Uuid
  estado             EstadoPublicacion @default(borrador)
  titulo             String
  descripcion        String?
  precioReferencia   Decimal?          @map("precio_referencia") @db.Decimal(14, 4)
  denominacionPrecio Denominacion?     @map("denominacion_precio")
  publicadaEn        DateTime?         @map("publicada_en") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  propiedad Propiedad @relation(fields: [propiedadId], references: [id])
  consultas ConsultaContacto[]
  denuncias Denuncia[]

  @@map("publicacion")
}

model Reserva {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  propiedadId  String        @map("propiedad_id") @db.Uuid
  personaId    String?       @map("persona_id") @db.Uuid
  fechaReserva DateTime      @default(now()) @map("fecha_reserva") @db.Date
  vigenteHasta DateTime?     @map("vigente_hasta") @db.Date
  estado       EstadoReserva @default(activa)
  notas        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  propiedad  Propiedad   @relation(fields: [propiedadId], references: [id])
  persona    Persona?    @relation(fields: [personaId], references: [id])
  documentos Documento[]

  @@map("reserva")
}

model Contrato {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  propiedadId         String             @map("propiedad_id") @db.Uuid
  arrendatarioId      String             @map("arrendatario_id") @db.Uuid
  propietarioId       String             @map("propietario_id") @db.Uuid
  estado              EstadoContrato     @default(borrador)
  denominacion        Denominacion
  valorArriendo       Decimal            @map("valor_arriendo") @db.Decimal(14, 4)
  diaVencimiento      Int                @map("dia_vencimiento") @db.SmallInt
  comisionCorredorPct Decimal            @default(0) @map("comision_corredor_pct") @db.Decimal(5, 2)
  /// Determina si el arriendo está afecto a IVA. Por regla general arrendar un
  /// inmueble es exento; el DL 825 art. 8 letra g) lo grava cuando se arrienda
  /// amoblado. El cálculo vive en @housing/core (ivaArriendo) y necesita además
  /// el avalúo fiscal de la propiedad: sin él no se puede aplicar la deducción
  /// del 11 % y se le cobraría de más al arrendatario.
  esAmoblado          Boolean            @default(false) @map("es_amoblado")
  reajuste            FrecuenciaReajuste @default(anual)
  moraTasaPct         Decimal            @default(0) @map("mora_tasa_pct") @db.Decimal(5, 2)
  moraDiasGracia      Int                @default(0) @map("mora_dias_gracia") @db.SmallInt
  cobraGastoComun     Boolean            @default(false) @map("cobra_gasto_comun")
  // Garantía (ADR-0009). La Ley 18.101 no fija un tope legal vigente para el
  // monto (revisión legal 2026-07-30 — ver contract-rules.ts); el rango 0-2
  // que aceptan las validaciones es práctica de mercado, no límite legal.
  //  · garantiaMeses:     nº de rentas pactadas como garantía (0–2 en la UI).
  //  · garantiaDenominacion + garantiaMontoBase: el monto PACTADO en su unidad
  //    (2 UF, o $760.000). Análogo a denominacion + valorArriendo del arriendo.
  //  · garantiaMontoCLP:  SNAPSHOT en pesos de lo recibido, a la UF del día de
  //    inicio. Es lo que registra el asiento GARANTIA_RECIBIDA (inmutable). Para
  //    garantía CLP coincide con el monto base; para UF es el equivalente del día.
  //    La devolución revaloriza montoBase a la UF del día de término (ver
  //    REAJUSTE_GARANTIA), no este snapshot.
  //  garantiaDenominacion/garantiaMontoBase son opcionales: contratos previos a
  //  esta migración solo tienen el CLP; el backfill los completa como CLP fijo.
  garantiaMeses        Decimal            @default(0) @map("garantia_meses") @db.Decimal(3, 1)
  garantiaDenominacion Denominacion?      @map("garantia_denominacion")
  garantiaMontoBase    Decimal?           @map("garantia_monto_base") @db.Decimal(14, 4)
  garantiaMontoCLP     Decimal            @default(0) @map("garantia_monto_clp") @db.Decimal(14, 0)
  fechaInicio         DateTime           @map("fecha_inicio") @db.Date
  fechaFin            DateTime?          @map("fecha_fin") @db.Date
  fechaTermino        DateTime?          @map("fecha_termino") @db.Date  // Fecha real en que se terminó/canceló
  /// Por qué terminó. Se fija al cerrar el contrato; null mientras está vigente
  /// o en borrador. No es taxonomía por prolijidad: de la causal dependen el
  /// plazo de restitución y qué procedimiento judicial procede.
  causalTermino       CausalTermino?     @map("causal_termino")
  /// Cuándo se notificó el desahucio. La Ley 18.101 cuenta los plazos de
  /// restitución desde la notificación y no desde la fecha de término, así que
  /// sin este dato el plazo no se puede calcular.
  fechaNotificacionDesahucio DateTime?   @map("fecha_notificacion_desahucio") @db.Date
  /// Inscripción del inmueble en el Conservador de Bienes Raíces; hoy el
  /// borrador del contrato la deja como marcador de texto. Fojas y número van
  /// como texto porque se transcriben literales a la cláusula ("234 vuelta").
  inscripcionCbrFojas       String?      @map("inscripcion_cbr_fojas")
  inscripcionCbrNumero      String?      @map("inscripcion_cbr_numero")
  inscripcionCbrAnio        Int?         @map("inscripcion_cbr_anio") @db.SmallInt
  inscripcionCbrConservador String?      @map("inscripcion_cbr_conservador")
  /// Si el contrato se firmó ante notario. Bajo la Ley 21.461 es lo que
  /// habilita el procedimiento monitorio: sin firma notarial el propietario
  /// queda en juicio ordinario.
  firmadoAnteNotario  Boolean            @default(false) @map("firmado_ante_notario")
  // Validación IA — resultado de la última validación automática
  validacionIa           Json?     @map("validacion_ia")
  validacionEstado       String?   @map("validacion_estado")     // "aprobado" | "con_alertas" | "requiere_revision"
  validacionAt           DateTime? @map("validacion_at")         @db.Timestamptz(6)
  validacionConfirmadaAt DateTime? @map("validacion_confirmada_at") @db.Timestamptz(6) // corredor confirmó a pesar de alertas
  tokenValoracion     String?            @unique @map("token_valoracion") @db.Uuid
  valoracionDada      Boolean            @default(false) @map("valoracion_dada")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  propiedad      Propiedad       @relation(fields: [propiedadId], references: [id])
  arrendatario   Persona         @relation("ContratoArrendatario", fields: [arrendatarioId], references: [id])
  propietario    Persona         @relation("ContratoPropietario", fields: [propietarioId], references: [id])
  periodos       PeriodoPago[]
  pagos          PagoEntrante[]
  asientos       AsientoLedger[]
  vouchers       Voucher[]
  notificaciones Notificacion[]
  documentos     Documento[]
  valoracion     ValoracionCorredor?
  comentarios    ComentarioCorredor[]

  @@index([tenantId])
  @@map("contrato")
}

model PeriodoPago {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  contratoId       String        @map("contrato_id") @db.Uuid
  numero           Int
  fechaInicio      DateTime      @map("fecha_inicio") @db.Date
  fechaVencimiento DateTime      @map("fecha_vencimiento") @db.Date
  montoBase        Decimal       @map("monto_base") @db.Decimal(14, 4)
  montoGastoComun  Decimal       @default(0) @map("monto_gasto_comun") @db.Decimal(14, 0)
  estado           EstadoPeriodo @default(pendiente)
  fechaPagoReal    DateTime?     @map("fecha_pago_real") @db.Date

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  contrato   Contrato        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pagos      PagoEntrante[]
  asientos   AsientoLedger[]
  vouchers   Voucher[]
  documentos Documento[]

  ajustes    AjusteLiquidacion[]

  @@unique([contratoId, numero])
  @@index([tenantId])
  @@map("periodo_pago")
}

// Ajustes que el corredor agrega antes de cerrar la liquidación (ADR-0008).
// Ej.: descuento por reparación, cargo por daño, retención de garantía.
model AjusteLiquidacion {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  periodoId   String     @map("periodo_id") @db.Uuid
  tipo        TipoAjuste
  montoCLP    Decimal    @map("monto_clp") @db.Decimal(14, 0)
  descripcion String
  creadoPorId String?    @map("creado_por") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  periodo   PeriodoPago @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  creadoPor Usuario?    @relation("AjusteCreadoPor", fields: [creadoPorId], references: [id])

  @@index([tenantId])
  @@index([periodoId])
  @@map("ajuste_liquidacion")
}

model PagoEntrante {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  contratoId        String?    @map("contrato_id") @db.Uuid
  periodoId         String?    @map("periodo_id") @db.Uuid
  montoClp          Decimal    @map("monto_clp") @db.Decimal(14, 0)
  fechaPagoReal     DateTime   @map("fecha_pago_real") @db.Date
  canal             CanalPago
  estado            EstadoPago @default(en_revision)
  comprobanteUrl    String?    @map("comprobante_url")
  declaracionJurada Boolean    @default(false) @map("declaracion_jurada")
  declaradoPorId    String?    @map("declarado_por") @db.Uuid
  confirmadoPorId   String?    @map("confirmado_por") @db.Uuid
  confirmadoEn      DateTime?  @map("confirmado_en") @db.Timestamptz(6)
  origen            String     @default("simulado")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  contrato      Contrato?       @relation(fields: [contratoId], references: [id])
  periodo       PeriodoPago?    @relation(fields: [periodoId], references: [id])
  declaradoPor  Usuario?        @relation("PagoDeclaradoPor", fields: [declaradoPorId], references: [id])
  confirmadoPor Usuario?        @relation("PagoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  asientos      AsientoLedger[]
  /// Comisión de Housing devengada por este pago (Fase D). Opcional: solo los
  /// pagos conciliados por el canal la generan, no los declarados a mano.
  comision      ComisionPlataforma?

  @@map("pago_entrante")
}

model AsientoLedger {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  contratoId     String        @map("contrato_id") @db.Uuid
  periodoId      String?       @map("periodo_id") @db.Uuid
  arrendatarioId String        @map("arrendatario_id") @db.Uuid
  propietarioId  String        @map("propietario_id") @db.Uuid
  tipo           TipoAsiento
  concepto       TipoConcepto?
  signo          Int           @default(1) @db.SmallInt
  montoClp       Decimal       @map("monto_clp") @db.Decimal(14, 0)
  monedaOrigen   Denominacion? @map("moneda_origen")
  valorOrigen    Decimal?      @map("valor_origen") @db.Decimal(14, 4)
  ufAplicada     Decimal?      @map("uf_aplicada") @db.Decimal(12, 2)
  fechaEvento    DateTime      @map("fecha_evento") @db.Date
  descripcion    String?
  reversaDeId    String?       @map("reversa_de") @db.Uuid
  pagoId         String?       @map("pago_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  contrato     Contrato        @relation(fields: [contratoId], references: [id])
  periodo      PeriodoPago?    @relation(fields: [periodoId], references: [id])
  arrendatario Persona         @relation("AsientoArrendatario", fields: [arrendatarioId], references: [id])
  propietario  Persona         @relation("AsientoPropietario", fields: [propietarioId], references: [id])
  reversaDe    AsientoLedger?  @relation("AsientoReversa", fields: [reversaDeId], references: [id])
  reversas     AsientoLedger[] @relation("AsientoReversa")
  pago         PagoEntrante?   @relation(fields: [pagoId], references: [id])

  @@index([tenantId])
  @@index([contratoId])
  @@index([periodoId])
  @@map("asiento_ledger")
}

model Voucher {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  contratoId     String      @map("contrato_id") @db.Uuid
  periodoId      String?     @map("periodo_id") @db.Uuid
  arrendatarioId String      @map("arrendatario_id") @db.Uuid
  tipo           TipoVoucher
  montoClp       Decimal     @map("monto_clp") @db.Decimal(14, 0)
  fecha          DateTime    @db.Date
  /// Folio legible del documento ("CP-2026-00042" pago, "LQ-2026-00042"
  /// liquidación). Correlativo por corredora, tipo y año (L-CP4). Nullable solo
  /// por los vouchers creados antes de existir el folio; todo voucher nuevo lo trae.
  folio          String?
  snapshot       Json        @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  contrato     Contrato     @relation(fields: [contratoId], references: [id])
  periodo      PeriodoPago? @relation(fields: [periodoId], references: [id])
  arrendatario Persona      @relation(fields: [arrendatarioId], references: [id])
  documentos   Documento[]

  @@map("voucher")
}

model Notificacion {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  personaId  String             @map("persona_id") @db.Uuid
  contratoId String?            @map("contrato_id") @db.Uuid
  tipo       TipoNotificacion
  canal      CanalNotificacion  @default(email)
  estado     EstadoNotificacion @default(pendiente)
  asunto     String
  cuerpo     String?
  payload    Json?
  // Alerta que originó esta notificación. Solo para tipo alerta_personalizada.
  // Existe como columna y no dentro de payload porque la generación automática
  // consulta por él para no repetir el mismo aviso dos veces.
  alertaId   String?            @map("alerta_id") @db.Uuid
  periodoId  String?            @map("periodo_id") @db.Uuid
  enviadaEn  DateTime?          @map("enviada_en") @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  persona  Persona   @relation(fields: [personaId], references: [id])
  contrato Contrato? @relation(fields: [contratoId], references: [id])
  alerta   AlertaPersonalizada? @relation(fields: [alertaId], references: [id])

  @@index([tenantId])
  @@index([personaId])
  @@index([alertaId, periodoId])
  @@map("notificacion")
}

/**
 * Alerta que el administrador de la corredora define una vez y queda
 * disponible para que cualquier corredor de la cuenta la use.
 *
 * Crear/editar es exclusivo del Manager (ADR-0013); enviarla la puede usar
 * cualquiera con acceso al contrato. El cuerpo admite marcadores del tipo
 * {{arrendatario}} que se reemplazan al enviar — ver lib/alertas.ts.
 *
 * Con `disparador` en null la alerta es solo manual. Con un disparador
 * definido, generarRecordatorios() la emite sola contra los períodos que
 * calcen, sin repetir (de ahí el índice [alertaId, periodoId] en Notificacion).
 */
model AlertaPersonalizada {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  nombre       String
  asunto       String
  cuerpo       String
  destinatario DestinatarioAlerta
  activa       Boolean            @default(true)
  disparador   DisparadorAlerta?
  diasOffset   Int?               @map("dias_offset") @db.SmallInt
  creadaPorId  String             @map("creada_por_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  creadaPor     Usuario        @relation(fields: [creadaPorId], references: [id])
  notificaciones Notificacion[]

  @@index([tenantId])
  @@map("alerta_personalizada")
}

/**
 * Preferencia de notificaciones de una persona (arrendatario o propietario).
 *
 * **La ausencia de fila significa suscrito.** Así, al generar un contrato la
 * persona queda suscrita sin necesidad de crear nada — y no hay forma de que
 * un olvido en el alta la deje sin avisos.
 *
 * `bajaHasta` distingue las dos formas de baja que la ley y el sentido común
 * piden separar: con fecha es una pausa (vacaciones, sobrecarga puntual); en
 * null con `suscrito = false` es una baja permanente, que el art. 28 B de la
 * Ley 19.496 obliga a respetar de forma indefinida una vez solicitada.
 */
model PreferenciaNotificacion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  personaId     String    @map("persona_id") @db.Uuid
  suscrito      Boolean   @default(true)
  /// Qué alcanza la baja. Solo tiene sentido con suscrito = false.
  alcance       AlcanceBaja @default(solo_opcionales)
  /// Fin de una baja temporal. null con suscrito=false ⇒ baja permanente.
  bajaHasta     DateTime? @map("baja_hasta") @db.Date
  motivo        String?
  // @default además de @updatedAt: sin default en la BD, cualquier INSERT que
  // no pase por Prisma (un backfill, un arreglo de datos por SQL) falla con
  // violación de NOT NULL. Detectado probando exactamente ese caso.
  actualizadoEn DateTime  @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  persona Persona @relation(fields: [personaId], references: [id])

  @@unique([tenantId, personaId])
  @@index([tenantId])
  @@map("preferencia_notificacion")
}

/**
 * Cuenta de un servicio básico asociada a una propiedad.
 *
 * Tabla relacionada y no columnas en Propiedad porque cada cuenta necesita
 * más que un número: la empresa proveedora, el titular y **quién paga**, que
 * es justamente lo que se discute al cerrar un contrato.
 *
 * NO lleva unique (propiedad, tipo): una propiedad subdividida puede tener
 * dos medidores de luz legítimamente.
 *
 * El titular es texto libre y no una FK a Persona: muchas veces la cuenta
 * sigue a nombre de un dueño anterior que no está en el sistema.
 */
model CuentaServicio {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  propiedadId String               @map("propiedad_id") @db.Uuid
  tipo        TipoServicioBasico
  estado      EstadoCuentaServicio @default(registrada)
  /// Null cuando estado = no_aplica.
  numero      String?
  empresa     String?
  titular     String?
  paga        PagadorServicio      @default(arrendatario)
  /// Nombre del servicio cuando tipo = otro ("Internet", "Alarma", "TV cable").
  /// Los cuatro básicos se nombran solos, así que no lo usan.
  etiqueta    String?
  /// Si el arrendatario y el propietario pueden verla en el portal. El corredor
  /// la ve siempre: esto decide qué comparte, no qué guarda.
  visibleEnPortal Boolean          @default(true) @map("visible_en_portal")
  notas       String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propiedadId])
  @@map("cuenta_servicio")
}

/**
 * Cuenta bancaria de destino de un pago.
 *
 * Una sola tabla para los dos casos porque son el mismo dato con el mismo
 * régimen de sensibilidad, y separarlos habría significado duplicar cinco
 * columnas y dos validaciones:
 *   · persona_id nulo    → la cuenta de la propia corredora, la que va en el
 *     recordatorio de pago para que el arrendatario sepa dónde transferir.
 *   · persona_id no nulo → la cuenta de un propietario, a la que se abona la
 *     liquidación.
 *
 * Una por titular: setup.sql lo asegura con un índice único parcial, porque el
 * @@unique de Prisma no alcanza cuando persona_id es nulo (en Postgres dos NULL
 * no chocan entre sí y se podrían crear varias cuentas de corredora).
 */
model CuentaBancaria {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  /// Null = cuenta de la corredora. No nulo = cuenta de ese propietario.
  personaId  String?            @map("persona_id") @db.Uuid
  banco      String
  tipo       TipoCuentaBancaria @default(corriente)
  numero     String
  /// El titular puede no ser el propietario del inmueble (una sociedad, un
  /// apoderado), así que nombre y RUT se guardan aparte y no se derivan.
  titular    String
  rutTitular String             @map("rut_titular")
  /// Correo al que el banco manda el comprobante de la transferencia.
  email      String?
  /// Si las partes pueden verla en el portal. Por defecto NO: un número de
  /// cuenta es de los datos más sensibles que guarda la plataforma. Que la
  /// cuenta de la corredora aparezca en el recordatorio de pago es otra cosa
  /// —ese documento va dirigido a quien debe pagar— y no pasa por acá.
  visibleEnPortal Boolean       @default(false) @map("visible_en_portal")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  persona Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@unique([tenantId, personaId])
  @@map("cuenta_bancaria")
}

/**
 * Rol de Avalúo de una unidad accesoria (estacionamiento, bodega).
 *
 * Opcional por diseño: la mayoría de las casas no tiene ninguno, y obligar a
 * llenarlos convertiría el caso común en el caso incómodo.
 */
model RolComplementario {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  propiedadId String                @map("propiedad_id") @db.Uuid
  tipo        TipoRolComplementario
  rol         String
  /// Identificación para el humano: "Estacionamiento 42", "Bodega B-7".
  descripcion String?
  /// Mismo criterio que en CuentaServicio: decide qué ve el portal.
  visibleEnPortal Boolean           @default(true) @map("visible_en_portal")
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([propiedadId])
  @@map("rol_complementario")
}

model Documento {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  tipo         TipoDocumento
  contratoId   String?       @map("contrato_id") @db.Uuid
  propiedadId  String?       @map("propiedad_id") @db.Uuid
  periodoId    String?       @map("periodo_id") @db.Uuid
  voucherId    String?       @map("voucher_id") @db.Uuid
  reservaId    String?       @map("reserva_id") @db.Uuid
  comentarioId String?       @map("comentario_id") @db.Uuid
  nombre       String
  storageKey   String        @map("storage_key")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  contrato   Contrato?            @relation(fields: [contratoId], references: [id])
  propiedad  Propiedad?           @relation(fields: [propiedadId], references: [id])
  periodo    PeriodoPago?         @relation(fields: [periodoId], references: [id])
  voucher    Voucher?             @relation(fields: [voucherId], references: [id])
  reserva    Reserva?             @relation(fields: [reservaId], references: [id])
  comentario ComentarioCorredor?  @relation(fields: [comentarioId], references: [id])
  accesosLog AccesoLog[]

  @@index([tenantId])
  @@index([contratoId])
  @@map("documento")
}

model AccesoOtp {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  personaId   String    @map("persona_id") @db.Uuid
  propiedadId String    @map("propiedad_id") @db.Uuid
  canal       CanalOtp
  codigoHash  String    @map("codigo_hash")
  expiraEn    DateTime  @map("expira_en") @db.Timestamptz(6)
  intentos    Int       @default(0) @db.SmallInt
  maxIntentos Int       @default(5) @map("max_intentos") @db.SmallInt
  usadoEn     DateTime? @map("usado_en") @db.Timestamptz(6)
  ipSolicitud String?   @map("ip_solicitud") @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  persona   Persona   @relation(fields: [personaId], references: [id])
  propiedad Propiedad @relation(fields: [propiedadId], references: [id])

  @@index([personaId])
  @@map("acceso_otp")
}

model AccesoLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  personaId   String?  @map("persona_id") @db.Uuid
  accion      String
  documentoId String?  @map("documento_id") @db.Uuid
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  persona   Persona?   @relation(fields: [personaId], references: [id])
  documento Documento? @relation(fields: [documentoId], references: [id])

  @@map("acceso_log")
}

// Auditoría de acciones de gestión de equipo (ADR-0013): invitar, asignar/
// desasignar propiedad, desactivar, reactivar. Alcance DELIBERADAMENTE
// acotado a estas 5 acciones — no es un log general de cada cobro/contrato
// que edite un colaborador (eso sería una feature de auditoría de datos
// mucho más grande). A diferencia de InvitacionColaborador, SÍ es
// tenant-scoped y SÍ entra al arreglo de RLS de setup.sql.
model AuditoriaEquipo {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  // "invitar" | "asignar_propiedad" | "desasignar_propiedad" | "desactivar" | "reactivar"
  accion      String
  objetivoId  String?  @map("objetivo_id") @db.Uuid
  propiedadId String?  @map("propiedad_id") @db.Uuid
  detalle     String?  // texto libre, ej. email invitado
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  actor     Usuario    @relation("AuditoriaActor", fields: [actorId], references: [id])
  objetivo  Usuario?   @relation("AuditoriaObjetivo", fields: [objetivoId], references: [id])
  propiedad Propiedad? @relation(fields: [propiedadId], references: [id])

  @@index([tenantId, createdAt])
  @@map("auditoria_equipo")
}

// Registro auditable de consentimiento explícito ANTES de enviar datos
// personales a un proveedor de IA externo (Groq): foto de carnet en /registro
// o texto de contrato en validar-doc. El servidor rechaza la llamada a la IA
// si no llega este consentimiento marcado en la misma request (ver
// registro/actions.ts y api/contratos/[id]/validar-doc/route.ts) — esta tabla
// es la evidencia persistida de que se pidió y se dio, no solo un checkbox
// de UI que no deja rastro.
model ConsentimientoIa {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  // "carnet_registro" | "contrato_validar_doc"
  flujo     String
  // Referencia libre al objeto concreto del envío (ej. contratoId) — no aplica
  // a carnet_registro, que es un evento único por cuenta.
  detalle   String?
  version   String   // versión del texto de consentimiento aceptado, ej. "ia-v1.0"
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, flujo])
  @@map("consentimiento_ia")
}

// ── Dispositivos de confianza ────────────────────────────────────────────────
// Registra los dispositivos que el usuario verificó por email.
// tokenHash = SHA-256(UUID raw) — nunca se guarda el token en texto claro.
model DispositivoConfiable {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  tokenHash  String   @map("token_hash") @db.Char(64)
  nombre     String                                                          // "Chrome en Windows"
  ipCreacion String?  @map("ip_creacion")
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at")  @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tokenHash])
  @@map("dispositivo_confiable")
}

// Código de 6 dígitos para verificar un dispositivo nuevo.
// Expira en 10 min. Máx 3 intentos fallidos.
model CodigoDispositivo {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  codigoHash  String    @map("codigo_hash") @db.Char(64)  // SHA-256(codigo + AUTH_SECRET)
  deviceToken String    @map("device_token") @db.Uuid     // UUID pre-confirmación
  expiraAt    DateTime  @map("expira_at") @db.Timestamptz(6)
  intentos    Int       @default(0) @db.SmallInt
  usadoAt     DateTime? @map("usado_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigo_dispositivo")
}

// Código de 6 dígitos para confirmar un cambio de teléfono o correo desde Mi
// perfil. Se envía SIEMPRE al correo actual de la sesión (canal ya
// verificado) — nunca al valor nuevo — para probar que quien pide el cambio
// sigue teniendo acceso a la cuenta antes de aceptar el nuevo dato.
// Sin tenantId a propósito (igual que codigo_dispositivo/reset_token): la
// sesión ya resuelve el usuarioId, no hace falta tenant para esta tabla, y
// por eso queda fuera del arreglo RLS de setup.sql.
model CodigoCambioContacto {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  campo      String    // "telefono" | "email"
  valorNuevo String    @map("valor_nuevo")
  codigoHash String    @map("codigo_hash") @db.Char(64)  // SHA-256(codigo + AUTH_SECRET)
  expiraAt   DateTime  @map("expira_at") @db.Timestamptz(6)
  intentos   Int       @default(0) @db.SmallInt
  usadoAt    DateTime? @map("usado_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("codigo_cambio_contacto")
}

// Token de un solo uso para recuperación de contraseña (CWE-640 mitigation).
model ResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  // SHA-256 hex del token raw — NUNCA se almacena el token en texto claro
  tokenHash String    @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usadoEn   DateTime? @map("usado_en")   @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([usuarioId])
  @@map("reset_token")
}

// Invitación de un solo uso para que un colaborador se una a la cuenta de un
// manager (ADR-0013) — mismo patrón que ResetToken. Sin tenantId a propósito:
// la página de aceptación no tiene sesión todavía y no puede conocer el
// tenant hasta decodificar el token; el tenant se resuelve vía
// auth_tenant_de_usuario(invitadoPorId) al aceptar. Por la misma razón queda
// FUERA del arreglo de RLS en setup.sql (como reset_token).
model InvitacionColaborador {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitadoPorId String    @map("invitado_por_id") @db.Uuid
  nombre        String
  email         String
  // SHA-256 hex del token raw — NUNCA se almacena el token en texto claro
  tokenHash     String    @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usadoEn       DateTime? @map("usado_en")   @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  invitadoPor Usuario @relation("InvitacionCreadaPor", fields: [invitadoPorId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([invitadoPorId])
  @@map("invitacion_colaborador")
}

// Series temporales globales (sin tenant).
model SerieUf {
  fecha    DateTime @id @db.Date
  valorClp Decimal  @map("valor_clp") @db.Decimal(12, 2)

  @@map("serie_uf")
}

model SerieIpc {
  periodo DateTime @id @db.Date
  indice  Decimal  @db.Decimal(10, 4)

  @@map("serie_ipc")
}

// ── Feature: Contacto público desde marketplace ───────────────────────────────

// Formulario de contacto enviado por un interesado desde la ficha de propiedad.
// El token de valoración es de un solo uso y activa el flujo de rating.
model ConsultaContacto {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicacionId    String   @map("publicacion_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  nombre           String
  apellido         String
  telefono         String
  email            String
  titulo           String
  descripcion      String   @db.Text
  quiereContacto   Boolean  @default(true)  @map("quiere_contacto")
  viaEmail         Boolean  @default(true)  @map("via_email")
  viaTelefono      Boolean  @default(false) @map("via_telefono")
  // Token de valoración: generado al enviar, quemado al valorar (single-use)
  tokenValoracion  String   @unique @map("token_valoracion") @db.Uuid
  valoracionDada   Boolean  @default(false) @map("valoracion_dada")
  ip               String?  @db.VarChar(45)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  publicacion Publicacion        @relation(fields: [publicacionId], references: [id])
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  valoracion  ValoracionCorredor?

  @@index([tenantId])
  @@index([publicacionId])
  @@map("consulta_contacto")
}

// ── Feature: Denuncia de propiedades/corredores ───────────────────────────────

enum TipoDenuncia {
  fraude_inmobiliario  // Venta/arriendo fraudulento
  estafa               // Apropiación de dineros/garantías
  informacion_falsa    // Datos falsos en publicación
  acoso                // Acoso o presión indebida al cliente
  discriminacion       // Discriminación arbitraria (Ley 20.609)
  incumplimiento       // Incumplimiento de contrato
  otro
}

enum ObjetivoDenuncia {
  propiedad
  corredor
}

// Denuncia anónima o identificada enviada al administrador de la plataforma.
// Cumple Ley 21.719 (datos personales), Art. 211 CP (denuncia calumniosa).
model Denuncia {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                  TipoDenuncia
  objetivo              ObjetivoDenuncia
  publicacionId         String?          @map("publicacion_id") @db.Uuid
  // Para identificar al corredor denunciado (si se conoce)
  nombreCorredor        String?          @map("nombre_corredor")
  descripcion           String           @db.Text
  evidenciaDescripcion  String?          @db.Text @map("evidencia_descripcion")
  // Datos del denunciante (opcionales si es anónima)
  esAnonima             Boolean          @default(false) @map("es_anonima")
  nombreDenunciante     String?          @map("nombre_denunciante")
  apellidoDenunciante   String?          @map("apellido_denunciante")
  emailDenunciante      String?          @map("email_denunciante")
  // Consentimientos obligatorios
  declaraVeracidad      Boolean          @map("declara_veracidad")   // Art. 211 CP — conoce consecuencias de falsa denuncia
  aceptaTratamientoDatos Boolean         @map("acepta_tratamiento_datos") // Ley 21.719
  estado                String           @default("recibida")  // recibida/en_revision/resuelta/desestimada
  ip                    String?          @db.VarChar(45)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  publicacion Publicacion? @relation(fields: [publicacionId], references: [id])

  @@index([publicacionId])
  @@map("denuncia")
}

// ── Feature: Comentarios del corredor al arrendatario ────────────────────────

// Mensajes que el corredor deja en el portal del arrendatario.
// Pueden incluir documentos adjuntos. Dispara notificación por email.
model ComentarioCorredor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  contratoId    String   @map("contrato_id") @db.Uuid
  texto         String   @db.Text
  usuarioNombre String   @default("") @map("usuario_nombre")  // desnormalizado para no unir
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  contrato   Contrato   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  documentos Documento[]

  @@index([tenantId])
  @@index([contratoId])
  @@map("comentario_corredor")
}

// ── Feature: Valoración de corredor ──────────────────────────────────────────

// Valoración de 1-5 estrellas dejada por un interesado o arrendatario (token de un solo uso).
// Origen: formulario de contacto (consultaId) O contrato vigente (contratoId).
model ValoracionCorredor {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  consultaId String?  @unique @map("consulta_id") @db.Uuid
  contratoId String?  @unique @map("contrato_id") @db.Uuid
  nombre     String   @default("")
  apellido   String   @default("")
  estrellas  Int      @db.SmallInt   // 1–5
  comentario String?  @db.Text
  esVisible  Boolean  @default(true) @map("es_visible")  // admin puede ocultar
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  consulta ConsultaContacto? @relation(fields: [consultaId], references: [id])
  contrato Contrato?         @relation(fields: [contratoId], references: [id])

  @@index([tenantId])
  @@map("valoracion_corredor")
}

/// Consumo diario de tokens de IA por tenant — enforcement del cupo que venden
/// los planes (Fase B0). Un token = una revisión de contrato con IA, tal como
/// lo dice el tooltip publicado.
///
/// Se guarda como AGREGADO por (tenant, día) en vez de una fila por llamada:
/// lo que se necesita es un contador con reset diario, no una bitácora. El
/// UNIQUE sobre (tenant_id, fecha) permite un upsert atómico con incremento,
/// que es lo que evita que dos peticiones simultáneas se pasen del cupo.
///
/// No cubre el escaneo de cédula del registro: ese ocurre ANTES de que exista
/// el tenant (y por tanto antes de que exista un plan), así que no hay cupo
/// contra el cual descontarlo.
model ConsumoIaDiario {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  /// Día del consumo en UTC. La fecha se calcula en el servidor, nunca desde
  /// el cliente: si no, bastaría con mentir la zona horaria para reiniciar el cupo.
  fecha    DateTime @db.Date
  usados   Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, fecha])
  @@index([tenantId])
  @@map("consumo_ia_diario")
}

// ═══════════════════════════════════════════════════════════════════════════
// BILLING — Housing ↔ corredor (ADR-0014)
//
// CONTABILIDAD SEPARADA, A PROPÓSITO. Estos modelos NO tocan `AsientoLedger`
// ni `PagoEntrante`, que modelan el dinero del arriendo entre arrendatario,
// propietario y corredor. Acá vive otra relación distinta: lo que el corredor
// le debe a Housing (suscripción + comisión por usar el canal de pago).
//
// Mezclarlas contaminaría la liquidación del propietario y las vistas
// financieras. No es una convención de estilo: hay un test de invariante que
// falla si un asiento de comisión de plataforma entra al ledger del contrato.
//
// Ojo con el nombre: `TipoAsiento.COMISION_CORREDOR` (ya existente) es la
// comisión que el CORREDOR le cobra al PROPIETARIO por administrar. La
// comisión de Housing es `ComisionPlataforma`, acá abajo. Son cosas distintas.
// ═══════════════════════════════════════════════════════════════════════════

enum EstadoSuscripcion {
  trial
  activa
  pago_pendiente   // cobro falló, en ventana de gracia (10 días — decisión D-10)
  suspendida       // venció la gracia sin pago: se corta el acceso, no se borra nada
  cancelada        // el corredor la dio de baja
  expirada         // terminó el período pagado y no se renovó
}

enum CicloFacturacion {
  mensual
  anual
}

enum TipoCargo {
  suscripcion
  comision_plataforma
}

enum EstadoCargo {
  pendiente
  pagado
  fallido
  reembolsado
}

enum EstadoComision {
  devengada   // el pago de arriendo se concilió; Housing ganó la comisión
  facturada   // quedó incluida en un CargoBilling de cierre de mes
  anulada     // se revirtió el pago que la originó
}

/// Suscripción del tenant a un plan. Reemplaza a `Tenant.plan` (string libre)
/// como fuente de verdad del plan vigente.
model SuscripcionTenant {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String            @map("tenant_id") @db.Uuid
  planId   String            @map("plan_id")   // "bronze" | "silver" | "gold" | "diamond"
  ciclo    CicloFacturacion
  estado   EstadoSuscripcion @default(activa)
  /// Referencia de la suscripción en el proveedor (null mientras no haya pasarela).
  gatewayRef   String? @map("gateway_ref")
  /// Medio de pago inscrito — token opaco del proveedor. Housing NUNCA guarda
  /// el número de tarjeta.
  medioPagoRef String? @map("medio_pago_ref")
  /// Hasta cuándo tiene derecho al servicio. Es esto lo que decide el acceso,
  /// no el estado: una suscripción `cancelada` sigue dando acceso hasta esta
  /// fecha (decisión D-05 — la baja se hace efectiva al terminar lo pagado).
  periodoActualHasta     DateTime @map("periodo_actual_hasta") @db.Timestamptz(6)
  /// Baja agendada: sigue activa hasta `periodoActualHasta` y no renueva.
  cancelaAlFinDelPeriodo Boolean  @default(false) @map("cancela_al_fin_del_periodo")
  /// Plan al que baja al terminar el período (D-05). Null = sin downgrade agendado.
  planAgendadoId         String?  @map("plan_agendado_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  cargos CargoBilling[]

  @@index([tenantId])
  @@map("suscripcion_tenant")
}

/// Todo cobro de Housing a un tenant: la suscripción o el consolidado mensual
/// de comisiones.
model CargoBilling {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  suscripcionId String?     @map("suscripcion_id") @db.Uuid
  tipo          TipoCargo
  estado        EstadoCargo @default(pendiente)
  /// Período que cubre, formato "2026-08". Junto con tipo y tenant forma la
  /// clave natural que impide cobrar dos veces lo mismo (índice en setup.sql).
  periodo       String

  // ── Montos ──────────────────────────────────────────────────────────────
  // Neto e IVA separados porque el DTE los necesita así (D-07).
  montoNetoClp  Decimal  @map("monto_neto_clp")  @db.Decimal(14, 0)
  ivaClp        Decimal  @map("iva_clp")         @db.Decimal(14, 0)
  montoTotalClp Decimal  @map("monto_total_clp") @db.Decimal(14, 0)
  /// Cotización en UF (solo suscripción — las comisiones son CLP fijo, D-14).
  montoUf       Decimal? @map("monto_uf")        @db.Decimal(14, 4)
  /// UF congelada al emitir el cargo (N-03). Sin esto no se puede explicar
  /// después por qué el cargo de un mes difiere del anterior.
  ufAplicada    Decimal? @map("uf_aplicada")     @db.Decimal(12, 2)

  // ── Ejecución ───────────────────────────────────────────────────────────
  /// Clave de idempotencia que Housing manda al proveedor. Única global: es la
  /// defensa contra el doble cobro si la red falla justo después de procesar.
  idempotencyKey       String  @unique @map("idempotency_key")
  gatewayRef           String? @map("gateway_ref")
  intentos             Int     @default(0) @db.SmallInt
  ultimoErrorCategoria String? @map("ultimo_error_categoria") // ver CategoriaErrorCobro
  ultimoErrorMensaje   String? @map("ultimo_error_mensaje")
  pagadoEn             DateTime? @map("pagado_en") @db.Timestamptz(6)
  /// Cuándo se notificó la mora — los 10 días de gracia corren desde acá, no
  /// desde el cobro fallido (decisión D-10).
  moraNotificadaEn     DateTime? @map("mora_notificada_en") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  suscripcion SuscripcionTenant?   @relation(fields: [suscripcionId], references: [id])
  comisiones  ComisionPlataforma[]

  @@index([tenantId])
  @@index([estado])
  @@map("cargo_billing")
}

/// Comisión que Housing devenga por cada pago de arriendo conciliado por el
/// canal (Fase D). Se devenga por pago EFECTIVAMENTE conciliado, nunca por
/// contrato activo: cobrar por pagos que Housing no procesó es indefendible.
model ComisionPlataforma {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  /// Pago que la originó. Único: un pago devenga una sola comisión.
  pagoEntranteId String         @unique @map("pago_entrante_id") @db.Uuid
  estado         EstadoComision @default(devengada)
  /// Monto fijo en CLP (D-14). No es un % del arriendo: desacopla el ingreso
  /// de Housing del tamaño del arriendo.
  montoClp       Decimal        @map("monto_clp") @db.Decimal(14, 0)
  /// Cargo de cierre de mes donde se facturó. Null mientras está devengada.
  cargoId        String?        @map("cargo_id") @db.Uuid
  devengadaEn    DateTime       @default(now()) @map("devengada_en") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  cargo  CargoBilling? @relation(fields: [cargoId], references: [id])
  pago   PagoEntrante  @relation(fields: [pagoEntranteId], references: [id])

  @@index([tenantId])
  @@index([estado])
  @@map("comision_plataforma")
}

/// Log crudo de webhooks. Doble propósito: idempotencia (el índice único de
/// `idExterno` impide procesar dos veces el mismo evento — los proveedores
/// reenvían) y auditoría (reconstruir qué dijo el proveedor exactamente, sin
/// depender de nuestra interpretación).
///
/// SIN `tenant_id` a propósito: cuando llega el webhook todavía no sabemos de
/// qué tenant es — se resuelve después, desde la referencia del proveedor. Por
/// eso queda fuera del RLS por tenant, igual que `invitacion_colaborador` y
/// `reset_token` (mismo motivo estructural, ver setup.sql). Es infraestructura:
/// ninguna consulta con cara al corredor debe leerla.
model EventoGatewayPago {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proveedor    String
  /// Id del evento EN EL PROVEEDOR. Único: es la clave de idempotencia.
  idExterno    String    @unique @map("id_externo")
  tipo         String
  /// Payload tal cual llegó, para auditar sin depender de cómo lo parseamos.
  payload      Json
  /// Null = recibido pero no procesado todavía (o falló el procesamiento).
  procesadoEn  DateTime? @map("procesado_en") @db.Timestamptz(6)
  errorProceso String?   @map("error_proceso")
  recibidoEn   DateTime  @default(now()) @map("recibido_en") @db.Timestamptz(6)

  @@index([proveedor, tipo])
  @@map("evento_gateway_pago")
}
