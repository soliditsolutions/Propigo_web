{
  "name": "propigo",
  "private": true,
  "version": "0.1.0",
  "description": "Propigo — plataforma PropTech de gestión de arriendos (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @propigo/web",
    "build": "npm run build --workspace @propigo/web",
    "start": "npm run start --workspace @propigo/web",
    "lint": "npm run lint --workspace @propigo/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  }
}
